{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clips",
  "type": "object",
  "required": ["clips"],
  "properties": {
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "hook"],
        "properties": {
          "id": { "type": "string", "pattern": "^clip-[0-9]{2}$" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "hook": { "type": "string", "maxLength": 60, "description": "Frase curta no topo do reel" },
          "reason": { "type": "string" },
          "overlays": {
            "type": "array",
            "description": "Componentes sobre o corte; at e dur em segundos relativos ao corte",
            "items": {
              "type": "object",
              "required": ["at", "dur", "type"],
              "properties": {
                "at": { "type": "number", "minimum": 0 },
                "dur": { "type": "number", "exclusiveMinimum": 0 },
                "type": { "enum": ["hook", "keyword", "step", "callout", "progress", "cta", "logo"] },
                "text": { "type": "string", "maxLength": 60 },
                "pos": { "enum": ["top", "bottom"], "description": "Só keyword, step e callout: faixa abaixo do gancho (top) ou acima da legenda (bottom, padrão)" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
