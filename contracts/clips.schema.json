{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clips",
  "type": "object",
  "required": ["clips"],
  "properties": {
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "hook"],
        "properties": {
          "id": { "type": "string", "pattern": "^clip-[0-9]{2}$" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "hook": { "type": "string", "maxLength": 60, "description": "Frase curta no topo do reel" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
