{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "theme",
  "type": "object",
  "required": ["id", "name", "colors", "fonts", "caption", "cta"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "colors": {
      "type": "object",
      "required": ["bg", "surface", "text", "muted", "accent"],
      "properties": {
        "bg": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "text": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accent2": { "$ref": "#/$defs/hex" },
        "success": { "$ref": "#/$defs/hex" },
        "warn": { "$ref": "#/$defs/hex" },
        "bad": { "$ref": "#/$defs/hex" },
        "glow": { "$ref": "#/$defs/hex", "description": "Brilho radial do fundo (50% x 25%)" },
        "gradient": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/hex" } }
      }
    },
    "fonts": {
      "type": "object",
      "required": ["title", "body"],
      "properties": { "title": { "type": "string" }, "body": { "type": "string" }, "mono": { "type": "string" } }
    },
    "caption": {
      "type": "object",
      "required": ["style", "position"],
      "properties": {
        "style": { "enum": ["word-highlight", "line"] },
        "position": { "enum": ["bottom", "center", "lower-third"] },
        "size": { "type": "integer", "minimum": 40, "maximum": 120 },
        "uppercase": { "type": "boolean" }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pad_before": { "type": "number", "minimum": 0 },
        "pad_after": { "type": "number", "minimum": 0 },
        "fade_in": { "type": "number", "minimum": 0 },
        "fade_out": { "type": "number", "minimum": 0 }
      }
    },
    "logo": { "type": ["string", "null"] },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kit da marca: ativos SVG dentro da pasta do tema e regras de painel e pacote",
      "properties": {
        "logo": { "type": ["string", "null"], "pattern": "^[^/\\\\][^\\\\]*\\.svg$", "description": "SVG relativo à pasta do tema" },
        "mascot": { "type": ["string", "null"], "pattern": "^[^/\\\\][^\\\\]*\\.svg$", "description": "SVG relativo à pasta do tema" },
        "mono": { "type": "string" },
        "panel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius": { "type": "integer", "minimum": 0, "maximum": 64 },
            "border": { "type": "string", "description": "Token de cor do tema ou hex" },
            "bar": { "type": "boolean" },
            "dots": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "glow": { "type": "boolean" },
            "radius": { "type": "integer", "minimum": 0, "maximum": 999 }
          }
        }
      }
    },
    "glossary": { "type": "object", "additionalProperties": { "type": "string" } },
    "vocabulary": { "type": "array", "items": { "type": "string" } },
    "cta": {
      "type": "object",
      "required": ["text"],
      "properties": { "text": { "type": "string" }, "handle": { "type": "string" } }
    }
  },
  "$defs": { "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
}
