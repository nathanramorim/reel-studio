{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenes",
  "type": "object",
  "required": ["style", "scenes"],
  "properties": {
    "style": { "type": "string" },
    "theme": { "type": "string" },
    "tone": { "type": "string", "maxLength": 40, "description": "Tom do roteiro" },
    "share": { "type": "string", "maxLength": 280, "description": "Copy para compartilhar o vídeo" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "dur", "narration"],
        "properties": {
          "type": { "enum": ["title", "highlight", "flow", "list", "compare", "chart", "quote", "cta"] },
          "dur": { "type": "number", "minimum": 1, "maximum": 15 },
          "narration": { "type": "string" },
          "source": {
            "type": "object",
            "description": "Trecho do vídeo de origem (segundos) cujo áudio acompanha a cena",
            "required": ["start", "end"],
            "properties": { "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 } },
            "additionalProperties": false
          },
          "media": {
            "type": "object",
            "description": "Trecho de vídeo mostrado na cena (segundos do vídeo de origem)",
            "required": ["source"],
            "properties": {
              "source": {
                "type": "object",
                "required": ["start", "end"],
                "properties": { "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 } },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "transition": { "enum": ["cut", "dip", "wipe", "slide"], "description": "Transição de saída para a próxima cena; o padrão vem do tom" },
          "text": { "type": "string", "maxLength": 80 },
          "steps": { "type": "array", "items": { "type": "string", "maxLength": 24 }, "maxItems": 6 },
          "items": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 5 },
          "left": { "type": "object", "properties": { "label": { "type": "string" }, "points": { "type": "array", "items": { "type": "string" } } } },
          "right": { "type": "object", "properties": { "label": { "type": "string" }, "points": { "type": "array", "items": { "type": "string" } } } },
          "values": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "number" } } } }
        },
        "additionalProperties": false
      }
    }
  }
}
